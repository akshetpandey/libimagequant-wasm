{
  "name": "libimagequant-wasm",
  "version": "0.3.0",
  "description": "WASM bindings for libimagequant image quantization library with Web Worker support",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.cjs",
      "default": "./dist/worker.mjs"
    },
    "./wasm/libimagequant_wasm.js": {
      "types": "./dist/wasm/libimagequant_wasm.d.ts",
      "default": "./dist/wasm/libimagequant_wasm.js"
    },
    "./wasm/libimagequant_wasm_bg.wasm": "./dist/wasm/libimagequant_wasm_bg.wasm"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm clean && vite build && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:wasm": "wasm-pack build --target web --out-dir dist/wasm -- --locked",
    "clean": "rm -rf dist/ target/",
    "preview": "vite dev",
    "serve": "vite dev --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manual": "pnpm build && pnpm serve",
    "test:package": "node examples/package-test.js",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "image",
    "quantization",
    "palette",
    "png",
    "gif",
    "optimization",
    "compression",
    "color-reduction",
    "web-worker"
  ],
  "author": "Akshet Pandey <argetlam.akshet@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshetpandey/libimagequant-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/akshetpandey/libimagequant-wasm/issues"
  },
  "homepage": "https://github.com/akshetpandey/libimagequant-wasm#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
