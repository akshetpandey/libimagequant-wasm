{
  "name": "libimagequant-wasm",
  "version": "0.4.0",
  "description": "Image quantization for browsers and Node.js with WebAssembly and worker support",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.cjs",
      "default": "./dist/worker.mjs"
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./node-worker": "./dist/node-worker.mjs",
    "./wasm/libimagequant_wasm.js": {
      "types": "./dist/wasm/libimagequant_wasm.d.ts",
      "default": "./dist/wasm/libimagequant_wasm.js"
    },
    "./wasm/libimagequant_wasm_bg.wasm": {
      "types": "./dist/wasm/libimagequant_wasm_bg.wasm.d.ts",
      "default": "./dist/wasm/libimagequant_wasm_bg.wasm"
    }
  },
  "sideEffects": [
    "./dist/worker.mjs",
    "./dist/worker.cjs"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "pnpm clean && vite build && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:wasm": "node scripts/build-wasm.mjs dist/wasm",
    "clean": "node scripts/clean.mjs",
    "preview": "vite dev",
    "serve": "vite dev --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manual": "pnpm build && pnpm serve",
    "test:package": "node examples/package-test.js",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "prepublishOnly": "pnpm build",
    "test:release": "node --test tests/release.test.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm format:check && pnpm lint:js && pnpm lint:rust && pnpm typecheck",
    "lint:js": "oxlint --deny-warnings .",
    "lint:rust": "cargo clippy --locked --all-targets --target wasm32-unknown-unknown -- -D warnings && cargo clippy --locked --all-targets -- -D warnings",
    "format": "oxfmt --write . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all -- --check"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "image",
    "quantization",
    "palette",
    "png",
    "gif",
    "optimization",
    "compression",
    "color-reduction",
    "web-worker",
    "nodejs",
    "worker-threads"
  ],
  "author": "Akshet Pandey <argetlam.akshet@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "cross-spawn": "^7.0.6",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akshetpandey/libimagequant-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/akshetpandey/libimagequant-wasm/issues"
  },
  "homepage": "https://github.com/akshetpandey/libimagequant-wasm#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
